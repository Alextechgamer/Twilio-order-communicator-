{
    "name": "alextechgamer/twilio-order-communicator-monorepo",
    "description": "Dev tooling for the WooCommerce plugin monorepo (PHP_CodeSniffer / WPCS / PHPCompatibility). Not required to run any plugin.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist -p",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist -p"
    }
}
