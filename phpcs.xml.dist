<?xml version="1.0"?>
<ruleset name="OrderRing monorepo">
	<description>
		WordPress coding standards for the plugins in this monorepo
		(twilio-order-communicator/, storecanvas/, orderbay/). The sibling
		license-server/ tree is a separate, non-WordPress PHP app and is not linted here.
		A full WPCS clean pass is deferred; this ruleset is for local/CI guidance,
		not a hard gate until the historical docblock/Yoda/alignment debt is paid down.
	</description>

	<file>twilio-order-communicator</file>
	<file>storecanvas</file>
	<file>orderbay</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<!-- Sibling app at repo root; never pulled into this ruleset. -->
	<exclude-pattern>*/license-server/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="parallel" value="4"/>

	<rule ref="WordPress">
		<!-- Allow short array syntax and modern PHP used throughout. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Admin UI built with inline markup; split gradually. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<config name="minimum_supported_wp_version" value="6.0"/>
	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
